# 复制为 .env.prod 后使用；直接运行 deploy-prod.sh 会自动生成并填入随机强凭据。
# 本文件含密钥，禁止提交到 Git，权限应为 600。

# ── Web 访问 ──────────────────────────────────────────────
# 只监听本机回环，由宿主机 Nginx 反代。确需直连公网时改为 0.0.0.0，
# 但必须同时配置防火墙白名单与 HTTPS，否则不建议。
WEB_BIND=127.0.0.1
WEB_PORT=9000

# ── 镜像构建 ──────────────────────────────────────────────
# 国内服务器用 Dockerfile-cn（apt / pip / npm 走国内源）；海外可改为 Dockerfile
BUILD_DOCKERFILE=Dockerfile-cn
BASE_IMAGE=python:3.11-slim-bookworm
NODE_IMAGE=node:24.22.2-bookworm-slim

# ── 运行参数 ──────────────────────────────────────────────
LOG_LEVEL=INFO
MEMORY_LIMIT=2048
CPU_LIMIT=2.0

# ── 密钥（由脚本生成，勿手填普通字符串）──────────────────
# SECRET_ENCRYPTION_KEY 必须是 Fernet key：32 字节的 url-safe base64，44 字符。
# 生成：python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# 该密钥用于加密数据库中的闲鱼 Cookie 等敏感字段，丢失后旧数据无法解密，请随备份一起保存。
SECRET_ENCRYPTION_KEY=

# 首次部署时由 deploy-prod.sh 用来把硬编码的 admin123 改成强密码。
# 注意：ADMIN_PASSWORD 对应用本身无效（代码未读取），仅作为脚本的凭据载体。
ADMIN_PASSWORD=
